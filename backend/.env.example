# Variables d'environnement — NE PAS VERSIONNER CE FICHIER

# ──────────────────────────────────────────────────────
#  Email SMTP Gmail
# ──────────────────────────────────────────────────────
# Mettez ici votre adresse Gmail
EMAIL_HOST_USER=votre.email@gmail.com

# Mot de passe d'APPLICATION Google (pas votre mot de passe Gmail normal !).
# Pour en générer un :
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Allez sur : https://myaccount.google.com/apppasswords
# 3. Créez un mot de passe d'application (ex: "ImmobilierPro Backend")
# 4. Copiez le code à 16 caractères ici (sans espaces)
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# ──────────────────────────────────────────────────────
#  Django Secret Key (à changer en production !)
# ──────────────────────────────────────────────────────
SECRET_KEY=django-insecure-changez-moi-en-production
