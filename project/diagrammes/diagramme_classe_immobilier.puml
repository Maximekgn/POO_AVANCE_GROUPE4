@startuml diagramme_classe_immobilier_mvp

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classFontName Arial
skinparam classBackgroundColor #F5F9FF
skinparam classBorderColor #2255AA
skinparam classHeaderBackgroundColor #1A4A8A
skinparam classHeaderFontColor #FFFFFF
skinparam classHeaderFontSize 12
skinparam classHeaderFontStyle bold
skinparam arrowColor #334466
skinparam arrowThickness 1.2
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
skinparam shadowing false
skinparam roundcorner 6

' ══════════════════════════════════════════════════════
'  ENUMERATIONS
' ══════════════════════════════════════════════════════

enum RoleEnum << (E,#AACFFF) >> {
  ADMIN
  PROPRIETAIRE
  CLIENT
}

enum StatutBienEnum << (E,#AACFFF) >> {
  EN_ATTENTE_VALIDATION
  VACANT
  LOUE
  EN_TRAVAUX
}

enum StatutBailEnum << (E,#AACFFF) >> {
  BROUILLON
  EN_ATTENTE_SIGNATURE
  EN_COURS
  EXPIRE
  RESILIE
}

enum StatutDossierEnum << (E,#AACFFF) >> {
  SOUMIS
  EN_ETUDE
  VALIDE
  REFUSE
}

enum StatutPaiementEnum << (E,#AACFFF) >> {
  EN_ATTENTE
  PAYE
  IMPAYE
}

enum TypeDocumentEnum << (E,#AACFFF) >> {
  QUITTANCE
  BAIL
  JUSTIFICATIF
  PIECE_IDENTITE
}

enum TypeSignataireEnum << (E,#AACFFF) >> {
  PROPRIETAIRE
  LOCATAIRE
}

' ══════════════════════════════════════════════════════
'  UTILISATEURS
' ══════════════════════════════════════════════════════

abstract class Utilisateur {
  - Long id
  - String nom
  - String prenom
  - String email
  - String motDePasse
  - String telephone
  - RoleEnum role
  - Boolean actif
  - Date dateCreation
  - Date dernierLogin
  --
  .. Authentification ..
  + login(email : String, mdp : String) : Boolean
  + logout() : void
  + changerMotDePasse(ancien : String, nouveau : String) : Boolean
  + reinitialiserMotDePasse(email : String) : void
  .. Profil ..
  + mettreAJourProfil() : void
  + getMessages() : List<Message>
  + getMessagesNonLus() : Integer
}

class Admin {
  --
  .. Gestion comptes ..
  + validerCompte(userId : Long) : void
  + suspendreCompte(userId : Long) : void
  + reactiverCompte(userId : Long) : void
  + listerUtilisateurs(filtre : String) : List<Utilisateur>
  .. Gestion biens (tous propriétaires) ..
  + validerBien(bienId : Long) : void
  + rejeterBien(bienId : Long, motif : String) : void
  + consulterTousLesBiens(filtre : String) : List<Bien>
  + modifierBienPour(bienId : Long, bien : Bien) : Bien
  + archiverBienPour(bienId : Long) : void
  .. Gestion locative (tous) ..
  + consulterToutesLesLocations() : List<Bail>
  + validerDossierPour(dossierId : Long) : void
  + rejeterDossierPour(dossierId : Long, motif : String) : void
  + resilierBailPour(bailId : Long, motif : String) : void
  .. Financier global ..
  + consulterFinancesGlobales() : Map<String, Double>
  + listerTousImpayes() : List<Paiement>
  + enregistrerPaiementPour(bailId : Long, paiement : Paiement) : void
  + consulterTableauDeBord() : Map<String, Object>
  .. Communication ..
  + envoyerMessageGlobal(message : String) : void
  + envoyerMessageA(userId : Long, message : String) : void
}

class Proprietaire {
  - String iban
  - String adresseFiscale
  - String numeroPiece
  - Long carteIdentiteId <<FK>>
  --
  .. Identité ..
  + uploaderCarteIdentite(doc : Document) : void
  + getCarteIdentite() : Document
  .. Gestion biens ..
  + ajouterBien(bien : Bien, photos : List<Photo>) : Bien
  + modifierBien(id : Long, bien : Bien) : Bien
  + archiverBien(id : Long) : void
  + listerMesBiens() : List<Bien>
  + listerBiensVacants() : List<Bien>
  .. Gestion locative ..
  + consulterDossiersCandidats(bienId : Long) : List<Dossier>
  + validerDossier(dossierId : Long) : void
  + refuserDossier(dossierId : Long, motif : String) : void
  + creerBail(dossierId : Long) : Bail
  + signerBail(bailId : Long, imageSignature : String) : void
  + resilierBail(bailId : Long, motif : String) : void
  .. Financier ..
  + validerPaiement(paiementId : Long) : void
  + enregistrerDepense(depense : Depense) : Depense
  + consulterRevenus(debut : Date, fin : Date) : Double
  + consulterDepenses(debut : Date, fin : Date) : Double
  + calculerBeneficeNet(debut : Date, fin : Date) : Double
  + listerImpayes() : List<Paiement>
  + exporterSynthese(format : String) : Document
  .. Locataires ..
  + listerMesLocataires() : List<Client>
}

class Client {
  - String profession
  - String numeroPiece
  - Long carteIdentiteId <<FK>>
  - Double revenusMensuels
  --
  .. Identité ..
  + uploaderCarteIdentite(doc : Document) : void
  + getCarteIdentite() : Document
  .. Recherche ..
  + rechercherBiens(ville : String, budget : Double, nbPieces : Integer) : List<Bien>
  + consulterDetailBien(bienId : Long) : Bien
  .. Dossier candidature ..
  + deposerDossier(bienId : Long, documents : List<Document>) : Dossier
  + completerDossier(dossierId : Long, doc : Document) : void
  + annulerDossier(dossierId : Long) : void
  + consulterMesDossiers() : List<Dossier>
  + consulterStatutDossier(dossierId : Long) : StatutDossierEnum
  .. Garant ..
  + ajouterGarant(garant : Garant) : void
  + modifierGarant(garantId : Long, garant : Garant) : void
  + supprimerGarant(garantId : Long) : void
  .. Bail & Paiements ..
  + consulterMonBail() : Bail
  + signerBail(bailId : Long, imageSignature : String) : void
  + consulterHistoriquePaiements() : List<Paiement>
  + consulterSolde() : Double
  + consulterProchaineEcheance() : Paiement
  + telechargerQuittance(mois : Integer, annee : Integer) : Document
  .. Réclamation ..
  + signalerProbleme(bailId : Long, description : String) : Message
}

class Garant {
  - Long id
  - Long clientId <<FK>>
  - String nom
  - String prenom
  - String telephone
  - String email
  - String profession
  - Double revenusMensuels
  - String numeroPiece
  - Long carteIdentiteId <<FK>>
  --
  + uploaderCarteIdentite(doc : Document) : void
  + getCarteIdentite() : Document
  + mettreAJour() : void
}

' ══════════════════════════════════════════════════════
'  PATRIMOINE IMMOBILIER
' ══════════════════════════════════════════════════════

class Bien {
  - Long id
  - Long proprietaireId <<FK>>
  - String reference
  - String adresse
  - String ville
  - String codePostal
  - String description
  - Double superficie
  - Integer nbPieces
  - Integer etage
  - Boolean meuble
  - Double loyerHC
  - Double charges
  - Double depotGarantie
  - StatutBienEnum statut
  - Date dateCreation
  --
  .. Statut ..
  + changerStatut(statut : StatutBienEnum) : void
  + estDisponible() : Boolean
  + estEnAttenteValidation() : Boolean
  .. Calculs ..
  + calculerLoyerTotal() : Double
  + calculerRentabilite(debut : Date, fin : Date) : Double
  + getTotalRevenus(debut : Date, fin : Date) : Double
  + getTotalDepenses(debut : Date, fin : Date) : Double
  .. Relations ..
  + getBailActif() : Bail
  + getLocataireActuel() : Client
  + getHistoriqueBaux() : List<Bail>
  + listerDossiersCandidats() : List<Dossier>
  .. Photos ..
  + ajouterPhoto(photo : Photo) : void
  + supprimerPhoto(photoId : Long) : void
  + getPhotoPrincipale() : Photo
  + reordonnerPhotos(ordreMap : Map<Long, Integer>) : void
}

class Photo {
  - Long id
  - Long bienId <<FK>>
  - String url
  - String description
  - Boolean principale
  - Integer ordre
  - Date dateUpload
  --
  + setPrincipale() : void
  + supprimer() : void
  + changerOrdre(nouvelOrdre : Integer) : void
}

' ══════════════════════════════════════════════════════
'  LOCATION & BAIL
' ══════════════════════════════════════════════════════

class Dossier {
  - Long id
  - Long clientId <<FK>>
  - Long bienId <<FK>>
  - Date dateDemande
  - StatutDossierEnum statut
  - String noteProprietaire
  - String motifRefus
  - Date dateTraitement
  --
  .. Cycle de vie ..
  + mettreEnEtude() : void
  + valider() : void
  + refuser(motif : String) : void
  .. Documents ..
  + ajouterDocument(doc : Document) : void
  + supprimerDocument(docId : Long) : void
  + listerDocuments() : List<Document>
  + estComplet() : Boolean
  + getDocumentsManquants() : List<String>
  .. Transition ..
  + genererBail() : Bail
}

class Bail {
  - Long id
  - Long bienId <<FK>>
  - Long clientId <<FK>>
  - Long dossierId <<FK>>
  - String numeroBail
  - Date dateEntree
  - Date dateSortie
  - Date dateSignatureProprietaire
  - Date dateSignatureClient
  - Double loyerActuel
  - Double depotGarantie
  - StatutBailEnum statut
  --
  .. Signatures ..
  + signerParProprietaire(imageSignature : String) : void
  + signerParClient(imageSignature : String) : void
  + estSigneParProprietaire() : Boolean
  + estSigneParClient() : Boolean
  + estSigneParTous() : Boolean
  + getSignatureProprietaire() : SignatureBail
  + getSignatureClient() : SignatureBail
  .. Cycle de vie ..
  + activer() : void
  + resilier(motif : String) : void
  + renouveler(nouvelleDateSortie : Date) : void
  + expirer() : void
  .. Vérifications ..
  + estActif() : Boolean
  + estExpirantBientot(joursAvant : Integer) : Boolean
  + getDureeRestante() : Integer
  .. Financier ..
  + genererEcheancier() : List<Paiement>
  + calculerTotalPercu() : Double
  + calculerTotalDu() : Double
  + getSoldeLocataire() : Double
  + getImpayes() : List<Paiement>
  + getProchaineEcheance() : Paiement
  .. Documents ..
  + genererDocumentBail() : Document
}

class SignatureBail {
  - Long id
  - Long bailId <<FK>>
  - Long utilisateurId <<FK>>
  - TypeSignataireEnum typeSignataire
  - String imageSignatureUrl
  - String ipAdresse
  - Date dateSignature
  - String hashIntegrite
  --
  + verifierIntegrite() : Boolean
  + getImageSignature() : Blob
  + estValide() : Boolean
}

' ══════════════════════════════════════════════════════
'  COMPTABILITÉ
' ══════════════════════════════════════════════════════

class Paiement {
  - Long id
  - Long bailId <<FK>>
  - String reference
  - Double montant
  - Date datePaiement
  - Date dateEcheance
  - StatutPaiementEnum statut
  - String modePaiement
  - String commentaire
  --
  + valider() : void
  + marquerImpaye() : void
  + estEnRetard() : Boolean
  + getNbJoursRetard() : Integer
  + genererQuittance() : Document
  + envoyerRappel() : Message
  + genererReference() : String
  + calculerPenaliteRetard(tauxJour : Double) : Double
}

class Depense {
  - Long id
  - Long proprietaireId <<FK>>
  - Long bienId <<FK>>
  - String categorie
  - String libelle
  - Double montant
  - Date dateDepense
  - String fournisseur
  - String numeroFacture
  --
  + enregistrer() : void
  + modifier() : void
  + supprimer() : void
  + ajouterJustificatif(doc : Document) : void
  + getJustificatif() : Document
}

' ══════════════════════════════════════════════════════
'  DOCUMENTS & MESSAGERIE
' ══════════════════════════════════════════════════════

class Document {
  - Long id
  - String nom
  - String url
  - TypeDocumentEnum type
  - Long tailleOctets
  - String mimeType
  - Date dateGeneration
  --
  + telecharger() : Blob
  + envoyer(email : String) : void
  + supprimer() : void
  + getExtension() : String
  + estImage() : Boolean
}

class Message {
  - Long id
  - Long expediteurId <<FK>>
  - Long destinataireId <<FK>>
  - Long conversationId
  - String objet
  - String contenu
  - Boolean lu
  - Date dateEnvoi
  --
  + marquerLu() : void
  + repondre(contenu : String) : Message
  + {static} getConversation(conversationId : Long) : List<Message>
  + {static} getConversationEntreUtilisateurs(userId1 : Long, userId2 : Long) : List<Message>
}

' ══════════════════════════════════════════════════════
'  HÉRITAGE
' ══════════════════════════════════════════════════════

Utilisateur <|-- Admin
Utilisateur <|-- Proprietaire
Utilisateur <|-- Client

' ══════════════════════════════════════════════════════
'  ASSOCIATIONS MÉTIER
' ══════════════════════════════════════════════════════

Proprietaire   "1"    -->  "0..*" Bien             : possède >
Proprietaire   "1"    -->  "1"    Document         : carte identité >
Bien           "1"    *--  "0..*" Photo            : illustré par
Bien           "1"    -->  "0..1" Bail             : couvert par >
Client         "1"    -->  "1"    Document         : carte identité >
Client         "1"    *--  "0..*" Garant           : possède >
Garant         "1"    -->  "1"    Document         : carte identité >
Client         "1"    -->  "0..*" Dossier          : soumet >
Dossier        "0..1" -->  "0..1" Bail             : aboutit à >
Bail           "1"    *--  "1..2" SignatureBail    : signé par
Bail           "1"    -->  "0..*" Paiement         : génère >
Proprietaire   "1"    -->  "0..*" Depense          : enregistre >
Bien           "1"    -->  "0..*" Depense          : concerne >
Paiement       "1"    -->  "0..1" Document         : produit quittance >
Bail           "1"    -->  "0..*" Document         : associé à >
Dossier        "1"    -->  "0..*" Document         : contient >
Depense        "1"    -->  "0..1" Document         : justifié par >
SignatureBail  "0..*" -->  "1"    Utilisateur      : signataire >
Message        "0..*" -->  "1"    Utilisateur      : expéditeur >
Message        "0..*" -->  "1"    Utilisateur      : destinataire >

' ══════════════════════════════════════════════════════
'  UTILISATION DES ENUMS
' ══════════════════════════════════════════════════════

Utilisateur    ..> RoleEnum
Bien           ..> StatutBienEnum
Bail           ..> StatutBailEnum
Dossier        ..> StatutDossierEnum
Paiement       ..> StatutPaiementEnum
Document       ..> TypeDocumentEnum
SignatureBail  ..> TypeSignataireEnum

@enduml