@startuml UC_Admin
title Cas d'utilisation - Admin

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseFontSize 12
skinparam actorFontSize 13

actor "Admin" as ADMIN

rectangle "Application Immobilier" {
  package "Espace Admin" {
    usecase "Se connecter" as UC_LOGIN
    usecase "Gerer les utilisateurs" as UC_USERS
    usecase "Gerer les categories\nde biens" as UC_CATEGORIE
    usecase "Valider / Refuser\nles demandes client" as UC_VALID_DEMANDE
    usecase "Superviser toutes\nles demandes" as UC_SUPERVISE
    usecase "Gerer la conformite\nRGPD" as UC_RGPD
    usecase "Gerer les\nparametres systeme" as UC_PARAMS
    usecase "Recevoir des\nnotifications" as UC_NOTIF_ADMIN
  }
}

ADMIN --> UC_LOGIN
ADMIN --> UC_USERS
ADMIN --> UC_CATEGORIE
ADMIN --> UC_VALID_DEMANDE
ADMIN --> UC_SUPERVISE
ADMIN --> UC_RGPD
ADMIN --> UC_PARAMS
ADMIN --> UC_NOTIF_ADMIN

@enduml
