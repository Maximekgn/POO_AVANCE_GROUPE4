@startuml UC_Proprietaire_Agence
title Cas d'utilisation - Proprietaire / Agence

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseFontSize 12
skinparam actorFontSize 13

actor "Proprietaire /\nAgence" as PROPRIO

rectangle "Application Immobilier" {
  package "Espace Proprietaire / Agence" {
    usecase "Se connecter" as UC_LOGIN
    usecase "Gerer ses biens\n(CRUD)" as UC_GERER_BIEN
    usecase "Consulter les\ndemandes recues" as UC_VOIR_DEMANDES
    usecase "Accepter / Refuser\nune demande" as UC_TRAITER_DEMANDE
    usecase "Gerer les baux" as UC_BAUX
    usecase "Suivre les paiements\ndes locataires" as UC_SUIVI_PAIE
    usecase "Saisir une depense" as UC_DEPENSE
    usecase "Consulter la balance\ncomptable" as UC_BALANCE
    usecase "Exporter formulaire\n2044" as UC_EXPORT
    usecase "Recevoir des\nnotifications" as UC_NOTIF_PROPRIO
  }
}

PROPRIO --> UC_LOGIN
PROPRIO --> UC_GERER_BIEN
PROPRIO --> UC_VOIR_DEMANDES
PROPRIO --> UC_TRAITER_DEMANDE
PROPRIO --> UC_BAUX
PROPRIO --> UC_SUIVI_PAIE
PROPRIO --> UC_DEPENSE
PROPRIO --> UC_BALANCE
PROPRIO --> UC_EXPORT
PROPRIO --> UC_NOTIF_PROPRIO

UC_EXPORT .> UC_BALANCE : <<include>>

@enduml
