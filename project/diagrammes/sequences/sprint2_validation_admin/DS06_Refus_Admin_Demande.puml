@startuml DS06_Refus_Admin_Demande
title DS06 - Refus Admin d'une Demande

autonumber
actor Admin
boundary "BackOffice Admin" as UI
control "AdminDemandeController" as ADC
control "AdminDemandeService" as ADS
database "DemandeRepository" as DREPO
database "UtilisateurRepository" as UREPO
control "NotificationService" as NOTIF

Admin -> UI : Refuse une demande SOUMISE avec motif
UI -> ADC : POST /admin/demandes/{id}/refuser
ADC -> ADS : refuserDemande(adminId, demandeId, motif)
ADS -> DREPO : findById(demandeId)
alt Demande inexistante
  DREPO --> ADS : null
  ADS --> ADC : erreur DEMANDE_INTROUVABLE
  ADC --> UI : 404 Not Found
else Demande trouvee
  DREPO --> ADS : demande
  ADS -> UREPO : verifierRole(adminId, ADMIN)
  UREPO --> ADS : role OK
  alt Motif vide
    ADS --> ADC : erreur MOTIF_OBLIGATOIRE
    ADC --> UI : 400 Bad Request
  else Motif valide
    ADS -> DREPO : update(statut=REFUSEE_ADMIN, motifRefusAdmin=motif, dateValidationAdmin=now)
    DREPO --> ADS : demande mise a jour
    ADS -> NOTIF : notifierClient(DEMANDE_REFUSEE_ADMIN, motif)
    NOTIF --> ADS : notification envoyee
    ADS --> ADC : refus enregistre
    ADC --> UI : 200 OK
    UI --> Admin : Refus confirme
  end
end
@enduml
