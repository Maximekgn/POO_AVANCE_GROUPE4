@startuml DS05_Validation_Admin_Demande
title DS05 - Validation Admin d'une Demande

autonumber
actor Admin
boundary "BackOffice Admin" as UI
control "AdminDemandeController" as ADC
control "AdminDemandeService" as ADS
database "DemandeRepository" as DREPO
database "UtilisateurRepository" as UREPO
control "NotificationService" as NOTIF

Admin -> UI : Ouvre une demande SOUMISE
UI -> ADC : POST /admin/demandes/{id}/valider
ADC -> ADS : validerDemande(adminId, demandeId)
ADS -> DREPO : findById(demandeId)
alt Demande inexistante
  DREPO --> ADS : null
  ADS --> ADC : erreur DEMANDE_INTROUVABLE
  ADC --> UI : 404 Not Found
else Demande trouvee
  DREPO --> ADS : demande
  alt Statut != SOUMISE
    ADS --> ADC : erreur STATUT_INVALIDE
    ADC --> UI : 409 Conflict
  else Statut SOUMISE
    ADS -> UREPO : verifierRole(adminId, ADMIN)
    UREPO --> ADS : role OK
    ADS -> DREPO : update(statut=VALIDEE_ADMIN, dateValidationAdmin=now)
    ADS -> DREPO : update(statut=TRANSMISE_PROPRIETAIRE)
    DREPO --> ADS : demande mise a jour
    ADS -> NOTIF : notifierProprietaire(VALIDATION_ADMIN_REQUISE)
    ADS -> NOTIF : notifierClient(DEMANDE_VALIDEE_ADMIN)
    NOTIF --> ADS : notifications envoyees
    ADS --> ADC : validation terminee
    ADC --> UI : 200 OK
    UI --> Admin : Demande transmise au proprietaire
  end
end
@enduml
