@startuml DS10_Impayes_Alertes
title DS10 - Detection d'Impayes et Envoi d'Alertes

autonumber
participant "Scheduler" as JOB
control "ImpayesService" as IMPS
database "BailRepository" as BAREPO
database "PaiementRepository" as PREPO
control "NotificationService" as NOTIF

JOB -> IMPS : lancerVerificationImpayes()
IMPS -> BAREPO : findBauxActifs()
BAREPO --> IMPS : listeBaux

loop Pour chaque bail actif
  IMPS -> PREPO : findPaiementMoisCourant(bailId)
  alt Aucun paiement valide
    PREPO --> IMPS : null
    IMPS -> PREPO : save(Paiement statut=IMPAYE)
    PREPO --> IMPS : impaye enregistre
    IMPS -> NOTIF : notifierClient(LOYER_IMPAYE)
    IMPS -> NOTIF : notifierProprietaire(LOYER_IMPAYE)
    NOTIF --> IMPS : notifications envoyees
  else Paiement valide trouve
    PREPO --> IMPS : paiement VALIDE
    IMPS -> IMPS : aucune action
  end
end

IMPS --> JOB : rapport de traitement
@enduml
