@startuml DS09_Paiement_Loyer_Quittance
title DS09 - Paiement du Loyer et Generation Quittance

autonumber
actor Client
boundary "Web App" as UI
control "PaiementController" as PAIC
control "PaiementService" as PAIS
control "PaymentGateway" as GATEWAY
database "BailRepository" as BAREPO
database "PaiementRepository" as PREPO
database "QuittanceRepository" as QREPO
control "QuittanceService" as QUITS
control "NotificationService" as NOTIF

Client -> UI : Payer le loyer mensuel
UI -> PAIC : POST /paiements
PAIC -> PAIS : payerLoyer(clientId, bailId, montant, mode)
PAIS -> BAREPO : findById(bailId)
alt Bail invalide
  BAREPO --> PAIS : bail absent ou non actif
  PAIS --> PAIC : erreur BAIL_INVALIDE
  PAIC --> UI : 409 Conflict
else Bail valide
  BAREPO --> PAIS : bail actif
  PAIS -> GATEWAY : autoriserPaiement(montant, mode)
  alt Paiement refuse
    GATEWAY --> PAIS : echec
    PAIS -> PREPO : save(Paiement statut=ANNULE)
    PREPO --> PAIS : paiement enregistre
    PAIS --> PAIC : paiement echoue
    PAIC --> UI : 402 Payment Required
  else Paiement accepte
    GATEWAY --> PAIS : succes
    PAIS -> PREPO : save(Paiement statut=VALIDE)
    PREPO --> PAIS : paiement valide
    PAIS -> QUITS : genererQuittance(paiementId)
    QUITS -> QREPO : save(Quittance)
    QREPO --> QUITS : quittance creee
    QUITS --> PAIS : quittanceId
    PAIS -> NOTIF : notifierClient(QUITTANCE_GENEREE)
    NOTIF --> PAIS : notification envoyee
    PAIS --> PAIC : paiement confirme + quittance
    PAIC --> UI : 200 OK
    UI --> Client : Paiement confirme
  end
end
@enduml
