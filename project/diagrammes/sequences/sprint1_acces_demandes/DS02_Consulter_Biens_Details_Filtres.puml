@startuml DS02_Consulter_Biens_Details_Filtres
title DS02 - Consultation des Biens, Filtres et Detail

autonumber
actor Client
boundary "Web App" as UI
control "BienController" as BIENC
control "BienService" as BIENS
database "BienRepository" as BREPO
database "CategorieRepository" as CREPO

Client -> UI : Ouvre la liste des biens
UI -> BIENC : GET /biens
BIENC -> BIENS : rechercherBiens(sans filtre)
BIENS -> BREPO : findDisponibles()
BREPO --> BIENS : listeBiens
BIENS --> BIENC : listeBiens
BIENC --> UI : 200 OK + biens
UI --> Client : Affiche les annonces

Client -> UI : Applique filtres (categorie, prix, statut)
UI -> BIENC : GET /biens?filtres
BIENC -> BIENS : rechercherBiens(filtres)
BIENS -> CREPO : verifierCategorie(filtreCategorie)
CREPO --> BIENS : categorie valide
BIENS -> BREPO : findByFiltres(filtres)
BREPO --> BIENS : listeFiltree
BIENS --> BIENC : listeFiltree
BIENC --> UI : 200 OK + listeFiltree
UI --> Client : Affiche resultats filtres

Client -> UI : Clique une annonce
UI -> BIENC : GET /biens/{bienId}
BIENC -> BIENS : recupererDetailBien(bienId)
BIENS -> BREPO : findById(bienId)
alt Bien inexistant
  BREPO --> BIENS : null
  BIENS --> BIENC : erreur BIEN_INTROUVABLE
  BIENC --> UI : 404 Not Found
else Bien trouve
  BREPO --> BIENS : detailBien
  BIENS --> BIENC : detailBien
  BIENC --> UI : 200 OK + detail
  UI --> Client : Affiche fiche detaillee
end
@enduml
