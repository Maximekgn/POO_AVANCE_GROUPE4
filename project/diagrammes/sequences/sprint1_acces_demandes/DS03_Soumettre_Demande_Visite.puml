@startuml DS03_Soumettre_Demande_Visite
title DS03 - Soumission Demande de Visite

autonumber
actor Client
boundary "Web App" as UI
control "DemandeController" as DEMC
control "DemandeService" as DEMS
database "BienRepository" as BREPO
database "DemandeRepository" as DREPO
control "NotificationService" as NOTIF

Client -> UI : Soumet date de visite souhaitee
UI -> DEMC : POST /demandes/visite
DEMC -> DEMS : creerDemandeVisite(clientId, bienId, date, message)
DEMS -> BREPO : findById(bienId)
alt Bien indisponible
  BREPO --> DEMS : bien statut != DISPONIBLE
  DEMS --> DEMC : erreur BIEN_NON_DISPONIBLE
  DEMC --> UI : 409 Conflict
  UI --> Client : Demande refusee
else Bien disponible
  BREPO --> DEMS : bien valide
  DEMS -> DREPO : save(DemandeVisite statut=SOUMISE)
  DREPO --> DEMS : demande creee
  DEMS -> NOTIF : notifierAdmin(NOUVELLE_DEMANDE)
  NOTIF --> DEMS : notification envoyee
  DEMS --> DEMC : demande enregistree
  DEMC --> UI : 201 Created
  UI --> Client : Demande envoyee (en attente admin)
end
@enduml
